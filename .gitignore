# ============================================================
# Assignment Management System
# Global Git Ignore
# ============================================================


# ------------------------------------------------------------
# Visual Studio / VS Code
# ------------------------------------------------------------

.vs/
.vscode/
*.user
*.userosscache
*.suo
*.userprefs
*.rsuser

# Visual Studio Code local settings
!.vscode/extensions.json
!.vscode/settings.example.json


# ------------------------------------------------------------
# .NET / ASP.NET Core
# ------------------------------------------------------------

**/bin/
**/obj/

# Build outputs
[Bb]in/
[Oo]bj/

# Test results
TestResults/
**/TestResults/
*.trx
*.coverage
*.coveragexml

# .NET generated files
*.dll
*.exe
*.pdb
*.cache
*.tmp

# NuGet
*.nupkg
*.snupkg
packages/
**/packages/

# NuGet local cache/config
.nuget/


# ------------------------------------------------------------
# ASP.NET Core local configuration / secrets
# ------------------------------------------------------------

# Local development configuration
appsettings.json
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json

# User secrets
secrets.json
secrets.*.json

# User-specific environment files
.env
.env.*
!.env.example
!.env.development.example
!.env.production.example

# IMPORTANT:
# Do NOT commit files containing:
# - Database passwords
# - JWT secrets
# - API keys
# - SMTP passwords
# - OAuth credentials


# ------------------------------------------------------------
# Node.js / Next.js / React
# ------------------------------------------------------------

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/cache/
.yarn/install-state.gz
.pnpm-store/

# Next.js
.next/
**/.next/

# Next.js build
out/
**/out/

# Vite
.vite/
**/.vite/

# React build
build/
**/build/

# Coverage
coverage/
**/coverage/

# TypeScript build info
*.tsbuildinfo


# ------------------------------------------------------------
# Environment files - Frontend
# ------------------------------------------------------------

frontend/**/.env
frontend/**/.env.*
!frontend/**/.env.example
!frontend/**/.env.development.example
!frontend/**/.env.production.example


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/
**/logs/


# ------------------------------------------------------------
# Operating System
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*.orig
*.old

# Temporary folders
tmp/
temp/
**/tmp/
**/temp/


# ------------------------------------------------------------
# Database / Local development files
# ------------------------------------------------------------

# SQLite local databases, if used during development
*.db
*.sqlite
*.sqlite3

# Local database dumps
*.dump
*.sql.gz

# PostgreSQL local files
postmaster.pid
postmaster.opts


# ------------------------------------------------------------
# Certificates / SSL
# ------------------------------------------------------------

*.pfx
*.p12
*.pem
*.key
*.crt

# NOTE:
# Do not commit private certificates or private keys.


# ------------------------------------------------------------
# Docker local overrides
# ------------------------------------------------------------

docker-compose.override.yml
docker-compose.local.yml


# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------

.idea/
*.iml

# Rider
*.sln.iml


# ------------------------------------------------------------
# Generated documentation / reports
# ------------------------------------------------------------

*.generated.*
*.generated.cs

# Local reports
reports/
**/reports/


# ------------------------------------------------------------
# Frontend generated files
# ------------------------------------------------------------

storybook-static/
dist/
**/dist/


# ------------------------------------------------------------
# OS / tooling
# ------------------------------------------------------------

.history/
.cache/
.parcel-cache/
.turbo/


# ------------------------------------------------------------
# Local uploads
# ------------------------------------------------------------

uploads/
**/uploads/

# User uploaded files should generally not be committed
storage/
**/storage/


# ------------------------------------------------------------
# Local seed/import/export files
# ------------------------------------------------------------

local-data/
local-seed/
*.local.json


# ------------------------------------------------------------
# Keep important example/configuration files
# ------------------------------------------------------------

!.gitignore
!.env.example
!appsettings.example.json
!README.md